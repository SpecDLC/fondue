 {
  "type": "commit",
  "node": "p:bechamel-classic",
  "author": "curated-core",
  "msg": "Classic béchamel, medium",
  "body": {
   "kind": "preparation",
   "name": "Classic Béchamel",
   "implements": [
    "c:bechamel"
   ],
   "yields": "2 cups",
   "facts": {
    "liquid": "@slot:liquid.liquid",
    "thickener": "@slot:starch.thickener",
    "fat": "@slot:fat.fat",
    "ratio_tbsp_per_cup": 2
   },
   "slots": [
    {
     "id": "fat",
     "role": "fat for roux",
     "concept": "c:cooking-fat",
     "qty": "4 Tbsp",
     "bind": {
      "node": "i:butter-unsalted"
     }
    },
    {
     "id": "starch",
     "role": "starch",
     "concept": "c:flour",
     "qty": "4 Tbsp",
     "bind": {
      "node": "i:flour-ap"
     }
    },
    {
     "id": "liquid",
     "role": "liquid",
     "concept": "c:cooking-liquid",
     "qty": "2 cups",
     "bind": {
      "node": "i:milk-whole"
     }
    },
    {
     "id": "salt",
     "role": "salt",
     "concept": "c:salt",
     "qty": "½ tsp",
     "bind": {
      "node": "i:salt-kosher"
     }
    },
    {
     "id": "nutmeg",
     "role": "nutmeg",
     "concept": "c:nutmeg",
     "qty": "pinch",
     "bind": {
      "node": "i:nutmeg"
     }
    }
   ],
   "steps": [
    {
     "verb": "WARM",
     "text": "Milk to steaming.",
     "mins": 3,
     "uses": [
      "liquid"
     ],
     "attend": false,
     "cue": "wisps of steam, no bubbles"
    },
    {
     "verb": "MELT",
     "text": "Fat into the saucepan, medium-low.",
     "mins": 1,
     "uses": [
      "fat"
     ],
     "attend": false,
     "cue": ""
    },
    {
     "verb": "WHISK",
     "text": "Flour in all at once. Stir constantly.",
     "mins": 2,
     "uses": [
      "starch"
     ],
     "attend": true,
     "cue": "toasty, still pale"
    },
    {
     "verb": "WHISK",
     "text": "Milk in three pours, smooth each time.",
     "mins": 2,
     "uses": [
      "liquid"
     ],
     "attend": true,
     "cue": "no lumps"
    },
    {
     "verb": "SIMMER",
     "text": "Lazy bubbles. Stir the corners.",
     "mins": 6,
     "uses": [],
     "attend": false,
     "cue": "nappe: a finger line on the spoon holds"
    },
    {
     "verb": "SALT",
     "text": "Salt, then taste.",
     "mins": 0.5,
     "uses": [
      "salt"
     ],
     "attend": false,
     "cue": ""
    },
    {
     "verb": "SEASON",
     "text": "Grate in nutmeg.",
     "mins": 0.5,
     "uses": [
      "nutmeg"
     ],
     "attend": false,
     "cue": ""
    }
   ],
   "variants": [
    {
     "when": {
      "slot": "fat",
      "fact": "salted",
      "eq": true
     },
     "delta": {
      "drop_slots": [
       "salt"
      ],
      "note": "Salted butter bound: skip the added salt and taste first."
     }
    }
   ]
  }
 },
