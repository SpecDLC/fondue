  "author": "curated-core",
  "canon": {
   "id": "classical",
   "name": "Classical French",
   "basis": "After classical French technique; contracts in our own words",
   "contracts": {
    "c:bechamel": {
     "must": [
      {
       "fact": "liquid",
       "op": "eq",
       "value": "dairy",
       "label": "dairy liquid"
      },
      {
       "fact": "thickener",
       "op": "eq",
       "value": "starch",
       "label": "starch-thickened"
      }
     ],
     "should": [
      {
       "fact": "fat",
       "op": "eq",
       "value": "butter",
       "label": "butter roux"
      },
      {
       "fact": "ratio_tbsp_per_cup",
       "op": "between",
       "value": [
        1.5,
        3
       ],
       "label": "1½–3 Tbsp roux per cup"
      }
     ]
    }
   },
   "prefer": {
    "c:bechamel": {
     "node": "p:bechamel-classic"
    }
   }
  }
 },
